#!/usr/bin/env bash
set -euo pipefail

pid_file="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/archi/pocket-tts-player.pid"
if [[ -r "$pid_file" ]]; then
  read -r pid < "$pid_file" || true
  if [[ "${pid:-}" =~ ^[0-9]+$ && -r "/proc/$pid/comm" ]] &&
    [[ "$(<"/proc/$pid/comm")" == "pw-play" ]]; then
    kill "$pid" 2>/dev/null || true
  fi
  rm -f "$pid_file"
fi
