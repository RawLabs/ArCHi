#!/usr/bin/env bash
set -euo pipefail

target="${1:-}"
class="$(hyprctl activewindow -j | jq -r '.class // ""')"

case "$target" in
  home)
    title="$(hyprctl activewindow -j | jq -r '.title // ""')"
    [[ "$class" =~ ^(org\.gnome\.Nautilus|org\.gnome\.NautilusPreviewer)$ && "$title" == "Home" ]]
    ;;
  downloads)
    title="$(hyprctl activewindow -j | jq -r '.title // ""')"
    [[ "$class" =~ ^(org\.gnome\.Nautilus|org\.gnome\.NautilusPreviewer)$ && "$title" == "Downloads" ]]
    ;;
  *) exit 2 ;;
esac

hyprctl dispatch 'hl.dsp.window.close()'
