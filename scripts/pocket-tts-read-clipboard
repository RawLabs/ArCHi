#!/usr/bin/env bash
set -euo pipefail

archi_bin_dir="${ARCHI_BIN_DIR:-$HOME/.local/bin}"
snapshot="$(mktemp)"

cleanup() {
  rm -f "$snapshot"
}
trap cleanup EXIT

# wl-paste documents "text" as a generic selector for the best offered text
# MIME type. Never fall back to automatic selection, which may choose binary
# application data when no text representation is available.
if ! wl-paste --no-newline --type text > "$snapshot" 2>/dev/null ||
  [[ ! -s "$snapshot" ]]; then
  command -v notify-send >/dev/null 2>&1 &&
    notify-send "ArCHi" "The clipboard has no readable text." || true
  exit 1
fi

if ! iconv -f UTF-8 -t UTF-8 "$snapshot" >/dev/null 2>&1 ||
  ! LC_ALL=C grep -Iq '[^[:space:]]' "$snapshot"; then
  command -v notify-send >/dev/null 2>&1 &&
    notify-send "ArCHi" "The clipboard does not contain valid readable text." || true
  exit 1
fi

"${ARCHI_TTS_SAY:-$archi_bin_dir/pocket-tts-say}" "$(<"$snapshot")"
