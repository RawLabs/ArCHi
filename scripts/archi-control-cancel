#!/usr/bin/env bash
set -euo pipefail

runtime_dir="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/archi"
monitor_pid_file="$runtime_dir/verbal-stop-monitor.pid"
# Invalidate the session first so a simultaneous verbal-stop detection cannot
# turn this cancellation into a submitted command.
rm -f "$runtime_dir/control-session-id"
if [[ -r "$monitor_pid_file" ]]; then
  monitor_pid="$(<"$monitor_pid_file")"
  if [[ "$monitor_pid" =~ ^[0-9]+$ ]] && [[ -r "/proc/$monitor_pid/cmdline" ]] &&
    tr '\0' ' ' < "/proc/$monitor_pid/cmdline" | grep -q 'archi-verbal-stop-monitor'; then
    kill "$monitor_pid" 2>/dev/null || true
  fi
fi
voxtype record cancel || true
rm -f "$runtime_dir/control-transcript.txt" "$runtime_dir/control-transcript.txt.done" \
  "$runtime_dir/control-start-ns" "$runtime_dir/verbal-stop-monitor.pid"
find "$runtime_dir" -maxdepth 1 -type f -name 'verbal-stop-*.wav' -delete 2>/dev/null || true
