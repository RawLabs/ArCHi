#!/usr/bin/env python3
"""Print the active ArCHi testing controls and accepted command phrases."""

from __future__ import annotations

import os
import sys
from pathlib import Path
import tomllib


BINDINGS = [
    ("Super + R", "start ArCHi command capture"),
    ("Super + R", "stop and submit active ArCHi capture"),
    ("say 'ArCHi stop'", "stop and submit active ArCHi capture"),
    ("Escape", "cancel while ArCHi capture is active"),
    ("Super + Shift + R", "start dictation/documentation mode"),
    ("Super + Shift + R", "stop and submit while dictation is active"),
    ("Escape", "cancel while dictation is active"),
    ("Super + Shift + V", "read the clipboard aloud"),
    ("Super + Ctrl + Up", "raise ArCHi voice volume"),
    ("Super + Ctrl + Down", "lower ArCHi voice volume"),
]


def main() -> int:
    archi_home = Path(os.environ.get("ARCHI_HOME", Path.home() / ".local" / "share" / "archi"))
    registry = Path(os.environ.get("ARCHI_COMMANDS_PATH", archi_home / "commands.toml"))
    try:
        with registry.open("rb") as stream:
            commands = tomllib.load(stream).get("commands", [])
    except (OSError, tomllib.TOMLDecodeError) as error:
        print(f"Could not read ArCHi registry {registry}: {error}")
        return 1

    print("ArCHi suggested testing key map (configure these bindings manually)")
    for keys, purpose in BINDINGS:
        print(f"  {keys:<27} {purpose}")
    print("\nAccepted production commands (say one phrase exactly)")
    for command in commands:
        if not command.get("phrases"):
            continue
        phrases = " | ".join(command.get("phrases", []))
        print(f"  {command['id']:<22} {phrases}")
    print("\nInstalled apps: say open/launch/start, close/quit/exit/dismiss, or switch to/focus/show plus an unambiguous app name.")
    print("Everyday names use desktop defaults: browser, terminal, file manager, editor, video player, image viewer, PDF viewer.")
    print("Music and calculator work when one installed app owns that role. Optional 'the' is accepted before app names.")
    sys.path.insert(0, str(archi_home))
    try:
        from router import load_commands, normalize
        by_phrase, by_id = load_commands()
    except (ImportError, OSError, ValueError) as error:
        print(f"Could not scan app-menu commands: {error}")
        return 1
    apps = sorted(
        (command for command in by_id.values() if command.get("capability") == "app.open"),
        key=lambda command: command["payload"]["app_name"].casefold(),
    )
    print(f"\nDiscovered app-menu entries ({len(apps)}):")
    for app in apps:
        phrases = [phrase for phrase in app["phrases"] if phrase.startswith("open ") and by_phrase.get(phrase) is app]
        if phrases:
            menu_phrase = "open " + normalize(app["payload"]["app_name"])
            opening_phrase = menu_phrase if menu_phrase in phrases else min(phrases, key=lambda phrase: (len(phrase), phrase))
            print(f"  {app['payload']['app_name']}: {opening_phrase}")
    print("Zoom/volume follow-ups: more, less, increase it, decrease it; cancel ends the adjustment.")
    print("\nDetailed test matrix: docs/TESTING.md")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
