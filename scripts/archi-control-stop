#!/usr/bin/env bash
set -euo pipefail

runtime_dir="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/archi"
archi_home="${ARCHI_HOME:-$HOME/.local/share/archi}"
transcript="$runtime_dir/control-transcript.txt"
session_file="$runtime_dir/control-session-id"
start_time_file="$runtime_dir/control-start-ns"
monitor_pid_file="$runtime_dir/verbal-stop-monitor.pid"
stop_lock="$runtime_dir/control-stop.lock"
trigger="key"
requested_session=""

while (($#)); do
  case "$1" in
    --verbal) trigger="verbal" ;;
    --timeout) trigger="timeout" ;;
    --session-id)
      shift
      requested_session="${1:-}"
      ;;
    *)
      printf 'Unknown option: %s\n' "$1" >&2
      exit 2
      ;;
  esac
  shift
done

if [[ -n "$requested_session" ]]; then
  [[ -r "$session_file" ]] || exit 0
  active_session="$(<"$session_file")"
  [[ "$active_session" == "$requested_session" ]] || exit 0
fi

if ! mkdir "$stop_lock" 2>/dev/null; then
  exit 0
fi
cleanup_lock() {
  rmdir "$stop_lock" 2>/dev/null || true
}
trap cleanup_lock EXIT

if [[ -r "$monitor_pid_file" ]]; then
  monitor_pid="$(<"$monitor_pid_file")"
  if [[ "$monitor_pid" =~ ^[0-9]+$ ]] && [[ "$monitor_pid" != "$$" ]] &&
    [[ -r "/proc/$monitor_pid/cmdline" ]] &&
    tr '\0' ' ' < "/proc/$monitor_pid/cmdline" | grep -q 'archi-verbal-stop-monitor'; then
    kill "$monitor_pid" 2>/dev/null || true
  fi
fi
rm -f "$monitor_pid_file"

wait_ticks="${ARCHI_TRANSCRIPT_WAIT_TICKS:-1200}"
if [[ ! "$wait_ticks" =~ ^[0-9]+$ ]] || ((wait_ticks < 1 || wait_ticks > 1800)); then
  wait_ticks=1200
fi
stop_started_ns="$(date +%s%N)"
voxtype record stop || true
if [[ "$trigger" != "key" ]]; then
  hyprctl eval 'hl.dispatch(hl.dsp.submap("reset"))' >/dev/null 2>&1 || true
fi

for ((attempt = 0; attempt < wait_ticks; attempt++)); do
  [[ -e "$transcript" || ! -e "$session_file" ]] && break
  voxtype_state_file="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/voxtype/state"
  if [[ -r "$voxtype_state_file" ]] && [[ "$(<"$voxtype_state_file")" == "idle" ]]; then
    break
  fi
  sleep 0.1
done

transcript_ready_ns="$(date +%s%N)"
transcript_wait_ms="$(( (transcript_ready_ns - stop_started_ns) / 1000000 ))"
capture_duration_ms=""
if [[ -e "$start_time_file" ]]; then
  capture_started_ns="$(<"$start_time_file")"
  rm -f "$start_time_file"
  if [[ "$capture_started_ns" =~ ^[0-9]+$ ]] && ((capture_started_ns <= stop_started_ns)); then
    capture_duration_ms="$(( (stop_started_ns - capture_started_ns) / 1000000 ))"
  fi
fi

session_id=""
if [[ -e "$session_file" ]]; then
  session_id="$(<"$session_file")"
  rm -f "$session_file"
fi

if [[ ! -e "$transcript" ]]; then
  ARCHI_SESSION_ID="$session_id" \
    ARCHI_CAPTURE_DURATION_MS="$capture_duration_ms" \
    ARCHI_TRANSCRIPT_WAIT_MS="$transcript_wait_ms" \
    python3 "$archi_home/router.py" --silent
  exit 0
fi

text="$(<"$transcript")"
rm -f "$transcript"
if [[ -z "${text//[[:space:]]/}" ]]; then
  ARCHI_SESSION_ID="$session_id" \
    ARCHI_CAPTURE_DURATION_MS="$capture_duration_ms" \
    ARCHI_TRANSCRIPT_WAIT_MS="$transcript_wait_ms" \
    python3 "$archi_home/router.py" --silent
else
  printf '%s' "$text" | ARCHI_SESSION_ID="$session_id" \
    ARCHI_CAPTURE_DURATION_MS="$capture_duration_ms" \
    ARCHI_TRANSCRIPT_WAIT_MS="$transcript_wait_ms" \
    python3 "$archi_home/router.py"
fi
